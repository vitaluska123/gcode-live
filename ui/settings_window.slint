import { Button, CheckBox } from "std-widgets.slint";
import { RenderSettingsPanel } from "components/settings_panel.slint";
import { UiSettings } from "globals.slint";

export component SettingsWindow inherits Window {
    min-width: 560px;
    min-height: 500px;
    preferred-width: 640px;
    preferred-height: 560px;
    title: "Настройки";

    callback preview_changed();
    callback save_settings();

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            vertical-stretch: 0;
            CheckBox {
                text: "Использовать OpenGL для предпросмотра";
                checked <=> UiSettings.use_opengl_renderer;
            }
            Text {
                text: "Изменение применяется после перезапуска приложения.";
                color: #96a0af;
                font-size: 12px;
            }
        }

        RenderSettingsPanel {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            preview_changed => { root.preview_changed(); }
        }

        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Сохранить настройки"; clicked => { root.save_settings(); } }
            Button { text: "Закрыть"; clicked => { root.hide(); } }
        }
    }
}
