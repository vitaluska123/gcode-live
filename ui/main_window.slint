
import { Button, LineEdit, GroupBox, TextEdit, CheckBox, TabWidget } from "std-widgets.slint";

// ============================================================
// PCB Frame Generator - Main Window UI
// ============================================================

export global UiSettings {
    in-out property<float> offset_x: 10.0;
    in-out property<float> offset_y: 10.0;
    in-out property<float> tab_width: 3.0;
    in-out property<float> minimum_tabs: 3.0;
    in-out property<float> maximum_tab_gap: 20.0;
    in-out property<bool> score_tabs: false;
    in-out property<bool> local_offset_enabled: false;
    in-out property<float> local_offset_x: 0.0;
    in-out property<float> local_offset_y: 0.0;
    in-out property<float> material_width: 150.0;
    in-out property<float> material_height: 150.0;
    in-out property<float> material_offset_x: 0.0;
    in-out property<float> material_offset_y: 0.0;
    in-out property<float> material_edge_margin_x: 0.0;
    in-out property<float> material_edge_margin_y: 0.0;
    in-out property<bool> show_grid: true; in-out property<bool> show_axes: true; in-out property<bool> show_material: true; in-out property<bool> show_safe_area: true; in-out property<bool> show_margin_hatch: true;
    in-out property<string> material_color: "#be64ff"; in-out property<string> safe_area_color: "#ff4646"; in-out property<string> frame_color: "#ff4664";
    in-out property<color> material_preview_color: #be64ff; in-out property<color> safe_area_preview_color: #ff4646; in-out property<color> frame_preview_color: #ff4664;
}

export component MainWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    title: "PCB Frame Generator";

    in-out property<string> board_width: "";
    in-out property<string> board_height: "";

    in-out property<string> x_min: "";
    in-out property<string> x_max: "";
    in-out property<string> y_min: "";
    in-out property<string> y_max: "";

    in-out property<string> frame_width: "";
    in-out property<string> frame_height: "";

    in-out property<bool> file_loaded: false;
    in-out property<image> preview_image;
    in-out property<float> preview_width: 1.0;
    in-out property<float> preview_height: 1.0;
    in-out property<string> cursor_coordinates: "X: —   Y: —";
    in-out property<int> active_tab: 0;
    in-out property<string> source_gcode: "";
    in-out property<bool> source_gcode_truncated: false;
    in-out property<string> final_gcode: "";

    callback open_tap_file();
    callback save_settings();
    callback export_tap();
    callback show_error(string);
    callback sync_settings();
    callback update_preview();
    callback render_preview(float, float) -> image;
    callback zoom_preview(int, float, float, float, float);
    callback fit_preview();
    callback begin_pan(float, float);
    callback pan_preview(float, float);
    callback cursor_moved(float, float, float, float);
    callback apply_source_gcode();
    callback apply_final_gcode();

    update_preview => {
        sync_settings();
        if (root.active_tab == 0) {
            preview_image = render_preview(root.preview_width, root.preview_height);
        }
    }


    // ========================================================
    // MAIN LAYOUT
    // ========================================================

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            padding: 8px;
            Button { text: "Открыть TAP"; clicked => { root.open_tap_file(); } }
            Button { text: "Сохранить настройки"; clicked => { root.save_settings(); } }
            Button { text: "Экспортировать TAP"; enabled: root.file_loaded; clicked => { root.export_tap(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // ====================================================
        // LEFT PANEL
        // ====================================================

        VerticalLayout {
            preferred-width: 340px;
            spacing: 12px;


            // =================================================
            // SETTINGS
            // =================================================

            GroupBox {
                title: "Настройки";

                TabWidget {
                    preferred-height: 350px;
                    Tab { title: "Настройки просчёта"; TabWidget {

                    Tab {
                        title: "Рамка";
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout { vertical-stretch: 0;
                                Text { text: "Запас рамки X (мм):"; vertical-alignment: center; }
                                LineEdit { text: UiSettings.offset_x + ""; preferred-width: 90px; accepted => { UiSettings.offset_x = self.text.to-float(); root.update_preview(); } }
                            }
                            HorizontalLayout { vertical-stretch: 0;
                                Text { text: "Запас рамки Y (мм):"; vertical-alignment: center; }
                                LineEdit { text: UiSettings.offset_y + ""; preferred-width: 90px; accepted => { UiSettings.offset_y = self.text.to-float(); root.update_preview(); } }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: "Координаты";
                        VerticalLayout {
                            spacing: 6px;
                            CheckBox { vertical-stretch: 0; text: "Включить локальный ноль"; checked <=> UiSettings.local_offset_enabled; toggled => { root.update_preview(); } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Смещение X (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.local_offset_x + ""; preferred-width: 90px; enabled: UiSettings.local_offset_enabled; accepted => { UiSettings.local_offset_x = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Смещение Y (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.local_offset_y + ""; preferred-width: 90px; enabled: UiSettings.local_offset_enabled; accepted => { UiSettings.local_offset_y = self.text.to-float(); root.update_preview(); } } }
                            Text { vertical-stretch: 0; text: "Положение текстолита относительно машинного нуля"; wrap: word-wrap; color: #aaaaaa; }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Ширина (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_width + ""; preferred-width: 90px; accepted => { UiSettings.material_width = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Высота (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_height + ""; preferred-width: 90px; accepted => { UiSettings.material_height = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Отступ X (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_offset_x + ""; preferred-width: 90px; accepted => { UiSettings.material_offset_x = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Отступ Y (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_offset_y + ""; preferred-width: 90px; accepted => { UiSettings.material_offset_y = self.text.to-float(); root.update_preview(); } } }
                            Text { vertical-stretch: 0; text: "Мин. отступ до края текстолита"; wrap: word-wrap; color: #aaaaaa; }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Отступ X (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_edge_margin_x + ""; preferred-width: 90px; accepted => { UiSettings.material_edge_margin_x = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Отступ Y (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.material_edge_margin_y + ""; preferred-width: 90px; accepted => { UiSettings.material_edge_margin_y = self.text.to-float(); root.update_preview(); } } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Tab {
                        title: "Перемычки";
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Ширина (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.tab_width + ""; preferred-width: 90px; accepted => { UiSettings.tab_width = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Минимум:"; vertical-alignment: center; } LineEdit { text: UiSettings.minimum_tabs + ""; preferred-width: 90px; accepted => { UiSettings.minimum_tabs = self.text.to-float(); root.update_preview(); } } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Макс. промежуток (мм):"; vertical-alignment: center; } LineEdit { text: UiSettings.maximum_tab_gap + ""; preferred-width: 90px; accepted => { UiSettings.maximum_tab_gap = self.text.to-float(); root.update_preview(); } } }
                            CheckBox { vertical-stretch: 0; text: "Надрезать перемычки до 50% глубины"; checked <=> UiSettings.score_tabs; toggled => { root.update_preview(); } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                } }
                    Tab { title: "Настройки отрисовки"; TabWidget {
                        Tab { title: "Текстолит"; VerticalLayout { spacing: 6px;
                            CheckBox { vertical-stretch: 0; text: "Показывать текстолит"; checked <=> UiSettings.show_material; toggled => { root.update_preview(); } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Цвет контура:"; vertical-alignment: center; } LineEdit { text <=> UiSettings.material_color; preferred-width: 100px; accepted => { root.update_preview(); } } Rectangle { horizontal-stretch: 1; } Rectangle { preferred-width: 6px; horizontal-stretch: 0; } Rectangle { width: 22px; height: 22px; horizontal-stretch: 0; vertical-stretch: 0; background: UiSettings.material_preview_color; border-radius: 4px; } }
                            CheckBox { vertical-stretch: 0; text: "Показывать безопасную зону"; checked <=> UiSettings.show_safe_area; toggled => { root.update_preview(); } }
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Цвет безопасной зоны:"; vertical-alignment: center; } LineEdit { text <=> UiSettings.safe_area_color; preferred-width: 100px; accepted => { root.update_preview(); } } Rectangle { horizontal-stretch: 1; } Rectangle { preferred-width: 6px; horizontal-stretch: 0; } Rectangle { width: 22px; height: 22px; horizontal-stretch: 0; vertical-stretch: 0; background: UiSettings.safe_area_preview_color; border-radius: 4px; } }
                            CheckBox { vertical-stretch: 0; text: "Штриховка зоны отступа"; checked <=> UiSettings.show_margin_hatch; toggled => { root.update_preview(); } }
                            Text { vertical-stretch: 0; text: "Цвета: #RRGGBB. Контуры — пунктир."; wrap: word-wrap; color: #aaaaaa; }
                            Rectangle { vertical-stretch: 1; }
                        } }
                        Tab { title: "Глобальные"; VerticalLayout { spacing: 6px;
                            CheckBox { vertical-stretch: 0; text: "Показывать сетку"; checked <=> UiSettings.show_grid; toggled => { root.update_preview(); } }
                            CheckBox { vertical-stretch: 0; text: "Показывать оси"; checked <=> UiSettings.show_axes; toggled => { root.update_preview(); } }
                            Rectangle { vertical-stretch: 1; }
                        } }
                        Tab { title: "Исходник"; VerticalLayout { spacing: 6px;
                            Text { vertical-stretch: 0; text: "Настройки отображения контура из исходного TAP."; wrap: word-wrap; color: #aaaaaa; }
                            Text { vertical-stretch: 0; text: "Будет добавлено в следующем обновлении."; color: #aaaaaa; }
                            Rectangle { vertical-stretch: 1; }
                        } }
                        Tab { title: "Зона"; VerticalLayout { spacing: 6px;
                            HorizontalLayout { vertical-stretch: 0; Text { text: "Цвет рамки:"; vertical-alignment: center; } LineEdit { text <=> UiSettings.frame_color; preferred-width: 100px; accepted => { root.update_preview(); } } Rectangle { horizontal-stretch: 1; } Rectangle { preferred-width: 6px; horizontal-stretch: 0; } Rectangle { width: 22px; height: 22px; horizontal-stretch: 0; vertical-stretch: 0; background: UiSettings.frame_preview_color; border-radius: 4px; } }
                            Text { vertical-stretch: 0; text: "Рамка — сплошная; расчётный контур с перемычками — пунктир."; wrap: word-wrap; color: #aaaaaa; }
                            Rectangle { vertical-stretch: 1; }
                        } }
                    } }
                }
            }


            // =================================================
            // FILE INFORMATION
            // =================================================

            GroupBox {
                title: "Сведения о файле";

                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;


                    Text {
                        text: "Размеры платы";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Ширина:";
                        }

                        Text {
                            text: root.board_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Высота:";
                        }

                        Text {
                            text: root.board_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Границы платы";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Мин. X:";
                        }

                        Text {
                            text: root.x_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Макс. X:";
                        }

                        Text {
                            text: root.x_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Мин. Y:";
                        }

                        Text {
                            text: root.y_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Макс. Y:";
                        }

                        Text {
                            text: root.y_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Размеры рамки";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Ширина:";
                        }

                        Text {
                            text: root.frame_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Высота:";
                        }

                        Text {
                            text: root.frame_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }


            // Fill unused vertical space.
            Rectangle {
                vertical-stretch: 1;
            }
        }


        // ====================================================
        // RIGHT PANEL - PREVIEW
        // ====================================================

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;


            TabWidget {
                current-index <=> root.active_tab;
                changed current-index => { root.update_preview(); }
                horizontal-stretch: 1;
                vertical-stretch: 1;

                Tab {
                    title: "Предпросмотр";
                    VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            changed width => { if (self.width > 1px) { root.preview_width = self.width / 1px; root.update_preview(); } }
                            changed height => { if (self.height > 1px) { root.preview_height = self.height / 1px; root.update_preview(); } }
                            Image { source: root.preview_image; width: 100%; height: 100%; image-fit: contain; }
                            TouchArea {
                                mouse-cursor: grab;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) { root.begin_pan(self.mouse-x / 1px, self.mouse-y / 1px); }
                                    if (event.kind == PointerEventKind.move) { root.cursor_moved(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); }
                                }
                                moved => { root.pan_preview(self.mouse-x / 1px, self.mouse-y / 1px); }
                                scroll-event(event) => {
                                    if (event.delta-y < 0) { root.zoom_preview(-1, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); }
                                    else { root.zoom_preview(1, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); }
                                    accept
                                }
                            }
                        }
                        HorizontalLayout {
                            Button { text: "Фокусировка на области"; preferred-width: 220px; clicked => { root.fit_preview(); } }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.cursor_coordinates; color: #aaaaaa; horizontal-alignment: right; }
                        }
                    }
                }
                Tab {
                    title: "Исходный G-code";
                    VerticalLayout {
                        Text { text: "Изменения вступят в силу после нажатия «Применить»."; color: #aaaaaa; }
                        Text {
                            text: "Большой файл показан частично, чтобы приложение работало стабильно.";
                            color: #e0a040;
                            visible: root.source_gcode_truncated;
                        }
                        TextEdit { text <=> root.source_gcode; font-family: "Consolas"; font-size: 14px; wrap: no-wrap; vertical-stretch: 1; }
                        HorizontalLayout { Button { text: "Применить исходный G-code"; enabled: !root.source_gcode_truncated; clicked => { root.apply_source_gcode(); } } Rectangle { horizontal-stretch: 1; } }
                    }
                }
                Tab {
                    title: "Финальный G-code";
                    VerticalLayout {
                        Text { text: "Правки влияют только на предпросмотр."; color: #aaaaaa; }
                        TextEdit { text <=> root.final_gcode; font-family: "Consolas"; font-size: 14px; wrap: no-wrap; vertical-stretch: 1; }
                        HorizontalLayout { Button { text: "Применить финальный G-code"; clicked => { root.apply_final_gcode(); } } Rectangle { horizontal-stretch: 1; } }
                    }
                }
            }
}
        }
    }
}
