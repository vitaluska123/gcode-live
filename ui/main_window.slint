
import { Button, LineEdit, GroupBox } from "std-widgets.slint";

// ============================================================
// PCB Frame Generator - Main Window UI
// ============================================================

export global UiSettings {
    in-out property<float> offset_x: 10.0;
    in-out property<float> offset_y: 10.0;
    in-out property<float> clamp_zone: 5.0;
    in-out property<float> safe_zone: 3.0;
    in-out property<float> tool_diameter: 3.175;
    in-out property<float> cut_depth: 1.6;
    in-out property<float> step_depth: 0.4;
    in-out property<float> feed_rate: 120;
    in-out property<float> spindle_speed: 800;
}

export component MainWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    title: "PCB Frame Generator";

    in-out property<string> board_width: "";
    in-out property<string> board_height: "";

    in-out property<string> x_min: "";
    in-out property<string> x_max: "";
    in-out property<string> y_min: "";
    in-out property<string> y_max: "";

    in-out property<string> frame_width: "";
    in-out property<string> frame_height: "";

    in-out property<bool> file_loaded: false;
    in-out property<image> preview_image;

    callback open_tap_file();
    callback save_settings();
    callback export_tap();
    callback show_error(string);
    callback sync_settings();
    callback update_preview();
    callback render_preview(float, float) -> image;
    callback zoom_preview(int);
    callback fit_preview();
    callback begin_pan(float, float);
    callback pan_preview(float, float);

    update_preview => {
        sync_settings();
        preview_image = render_preview(preview.width / 1px, preview.height / 1px);
    }


    // ========================================================
    // MAIN LAYOUT
    // ========================================================

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            padding: 8px;
            Button { text: "Открыть TAP"; clicked => { root.open_tap_file(); } }
            Button { text: "Сохранить настройки"; clicked => { root.save_settings(); } }
            Button { text: "Экспортировать TAP"; enabled: root.file_loaded; clicked => { root.export_tap(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // ====================================================
        // LEFT PANEL
        // ====================================================

        VerticalLayout {
            preferred-width: 340px;
            spacing: 12px;


            // =================================================
            // SETTINGS
            // =================================================

            GroupBox {
                title: "Настройки";

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;


                    HorizontalLayout {
                        Text {
                            text: "Offset X (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.offset_x + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.offset_x = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Offset Y (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.offset_y + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.offset_y = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Clamp Zone (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.clamp_zone + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.clamp_zone = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Safe Zone (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.safe_zone + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.safe_zone = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Tool Diameter (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.tool_diameter + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.tool_diameter = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Cut Depth (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.cut_depth + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.cut_depth = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Step Depth (mm):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.step_depth + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.step_depth = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Feed Rate (mm/min):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.feed_rate + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.feed_rate = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Spindle Speed (RPM):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.spindle_speed + "";

                            horizontal-stretch: 1;

                            accepted => {
                                UiSettings.spindle_speed = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }
                }
            }


            // =================================================
            // FILE INFORMATION
            // =================================================

            GroupBox {
                title: "File Information";

                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;


                    Text {
                        text: "Board Dimensions";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Width:";
                        }

                        Text {
                            text: root.board_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Height:";
                        }

                        Text {
                            text: root.board_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Board Bounds";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "X Min:";
                        }

                        Text {
                            text: root.x_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "X Max:";
                        }

                        Text {
                            text: root.x_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Y Min:";
                        }

                        Text {
                            text: root.y_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Y Max:";
                        }

                        Text {
                            text: root.y_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Frame Dimensions";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Width:";
                        }

                        Text {
                            text: root.frame_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Height:";
                        }

                        Text {
                            text: root.frame_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }


            // Fill unused vertical space.
            Rectangle {
                vertical-stretch: 1;
            }
        }


        // ====================================================
        // RIGHT PANEL - PREVIEW
        // ====================================================

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;


            Text {
                text: "Предпросмотр";
                font-weight: 600;
            }


            Rectangle {
                preview := Rectangle {
                    width: 100%;
                    height: 100%;
                }
                horizontal-stretch: 1;
                vertical-stretch: 1;

                Image {
                    source: root.preview_image;

                    width: 100%;
                    height: 100%;

                    image-fit: contain;
                }
                TouchArea {
                    mouse-cursor: grab;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.begin_pan(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    moved => { root.pan_preview(self.mouse-x / 1px, self.mouse-y / 1px); }
                    scroll-event(event) => {
                        if (event.delta-y < 0) {
                            root.zoom_preview(1);
                        } else {
                            root.zoom_preview(-1);
                        }
                        accept
                    }
                }
            }

            HorizontalLayout {
                Button { text: "−"; clicked => { root.zoom_preview(-1); } }
                Button { text: "Fit"; clicked => { root.fit_preview(); } }
                Button { text: "+"; clicked => { root.zoom_preview(1); } }
                Text { text: "Масштаб"; color: #888888; }
            }


            HorizontalLayout {
                spacing: 20px;


                Text {
                    text: "Board: "
                        + root.board_width
                        + " × "
                        + root.board_height;
                }


                Text {
                    text: "Frame: "
                        + root.frame_width
                        + " × "
                        + root.frame_height;
                }


                Rectangle {
                    horizontal-stretch: 1;
        }
    }
}
        }
    }
}
