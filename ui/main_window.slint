
import { Button, LineEdit, GroupBox, TextEdit, CheckBox } from "std-widgets.slint";

// ============================================================
// PCB Frame Generator - Main Window UI
// ============================================================

export global UiSettings {
    in-out property<float> offset_x: 10.0;
    in-out property<float> offset_y: 10.0;
    in-out property<float> tab_width: 3.0;
    in-out property<float> minimum_tabs: 3.0;
    in-out property<float> maximum_tab_gap: 20.0;
    in-out property<bool> local_offset_enabled: false;
    in-out property<float> local_offset_x: 0.0;
    in-out property<float> local_offset_y: 0.0;
    in-out property<float> material_width: 150.0;
    in-out property<float> material_height: 150.0;
}

export component MainWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    title: "PCB Frame Generator";

    in-out property<string> board_width: "";
    in-out property<string> board_height: "";

    in-out property<string> x_min: "";
    in-out property<string> x_max: "";
    in-out property<string> y_min: "";
    in-out property<string> y_max: "";

    in-out property<string> frame_width: "";
    in-out property<string> frame_height: "";

    in-out property<bool> file_loaded: false;
    in-out property<image> preview_image;
    in-out property<float> preview_width: 1.0;
    in-out property<float> preview_height: 1.0;
    in-out property<string> cursor_coordinates: "X: —   Y: —";
    in-out property<int> active_tab: 0;
    in-out property<string> source_gcode: "";
    in-out property<string> final_gcode: "";

    callback open_tap_file();
    callback save_settings();
    callback export_tap();
    callback show_error(string);
    callback sync_settings();
    callback update_preview();
    callback render_preview(float, float) -> image;
    callback zoom_preview(int);
    callback fit_preview();
    callback begin_pan(float, float);
    callback pan_preview(float, float);
    callback cursor_moved(float, float, float, float);
    callback apply_source_gcode();
    callback apply_final_gcode();

    update_preview => {
        sync_settings();
        if (root.active_tab == 0) {
            preview_image = render_preview(root.preview_width, root.preview_height);
        }
    }


    // ========================================================
    // MAIN LAYOUT
    // ========================================================

    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            padding: 8px;
            Button { text: "Открыть TAP"; clicked => { root.open_tap_file(); } }
            Button { text: "Сохранить настройки"; clicked => { root.save_settings(); } }
            Button { text: "Экспортировать TAP"; enabled: root.file_loaded; clicked => { root.export_tap(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // ====================================================
        // LEFT PANEL
        // ====================================================

        VerticalLayout {
            preferred-width: 340px;
            spacing: 12px;


            // =================================================
            // SETTINGS
            // =================================================

            GroupBox {
                title: "Настройки";

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;


                    HorizontalLayout {
                        Text {
                            text: "Запас рамки X (мм):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.offset_x + "";

                            preferred-width: 90px;

                            accepted => {
                                UiSettings.offset_x = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: "Запас рамки Y (мм):";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: UiSettings.offset_y + "";

                            preferred-width: 90px;

                            accepted => {
                                UiSettings.offset_y = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }

                    Text { text: "Глобальные координаты"; font-weight: 600; }
                    CheckBox {
                        text: "Включить локальный ноль";
                        checked <=> UiSettings.local_offset_enabled;
                        toggled => { root.update_preview(); }
                    }
                    HorizontalLayout {
                        Text { text: "Смещение X (мм):"; vertical-alignment: center; }
                        LineEdit { text: UiSettings.local_offset_x + ""; preferred-width: 90px; enabled: UiSettings.local_offset_enabled; accepted => { UiSettings.local_offset_x = self.text.to-float(); root.update_preview(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Смещение Y (мм):"; vertical-alignment: center; }
                        LineEdit { text: UiSettings.local_offset_y + ""; preferred-width: 90px; enabled: UiSettings.local_offset_enabled; accepted => { UiSettings.local_offset_y = self.text.to-float(); root.update_preview(); } }
                    }
                    Text { text: "Текстолит: X −ширина…0, Y 0…высота"; wrap: word-wrap; color: #aaaaaa; }
                    HorizontalLayout {
                        Text { text: "Ширина (мм):"; vertical-alignment: center; }
                        LineEdit { text: UiSettings.material_width + ""; preferred-width: 90px; accepted => { UiSettings.material_width = self.text.to-float(); root.update_preview(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Высота (мм):"; vertical-alignment: center; }
                        LineEdit { text: UiSettings.material_height + ""; preferred-width: 90px; accepted => { UiSettings.material_height = self.text.to-float(); root.update_preview(); } }
                    }

                    Text { text: "Перемычки"; font-weight: 600; }

                    HorizontalLayout {
                        Text { text: "Ширина (мм):"; vertical-alignment: center; }
                        LineEdit {
                            text: UiSettings.tab_width + "";
                            preferred-width: 90px;
                            accepted => {
                                UiSettings.tab_width = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }

                    HorizontalLayout {
                        Text { text: "Минимум:"; vertical-alignment: center; }
                        LineEdit {
                            text: UiSettings.minimum_tabs + "";
                            preferred-width: 90px;
                            accepted => {
                                UiSettings.minimum_tabs = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }

                    HorizontalLayout {
                        Text { text: "Макс. промежуток (мм):"; vertical-alignment: center; }
                        LineEdit {
                            text: UiSettings.maximum_tab_gap + "";
                            preferred-width: 90px;
                            accepted => {
                                UiSettings.maximum_tab_gap = self.text.to-float();
                                root.update_preview();
                            }
                        }
                    }


                }
            }


            // =================================================
            // FILE INFORMATION
            // =================================================

            GroupBox {
                title: "File Information";

                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;


                    Text {
                        text: "Board Dimensions";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Width:";
                        }

                        Text {
                            text: root.board_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Height:";
                        }

                        Text {
                            text: root.board_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Board Bounds";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "X Min:";
                        }

                        Text {
                            text: root.x_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "X Max:";
                        }

                        Text {
                            text: root.x_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Y Min:";
                        }

                        Text {
                            text: root.y_min;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Y Max:";
                        }

                        Text {
                            text: root.y_max;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    Text {
                        text: "Frame Dimensions";
                        font-weight: 600;
                    }


                    HorizontalLayout {
                        Text {
                            text: "Width:";
                        }

                        Text {
                            text: root.frame_width;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }


                    HorizontalLayout {
                        Text {
                            text: "Height:";
                        }

                        Text {
                            text: root.frame_height;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }


            // Fill unused vertical space.
            Rectangle {
                vertical-stretch: 1;
            }
        }


        // ====================================================
        // RIGHT PANEL - PREVIEW
        // ====================================================

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;


            HorizontalLayout {
                Button { text: "Предпросмотр"; clicked => { root.active_tab = 0; root.update_preview(); } }
                Button { text: "Исходный G-code"; clicked => { root.active_tab = 1; } }
                Button { text: "Финальный G-code"; clicked => { root.active_tab = 2; } }
                Rectangle { horizontal-stretch: 1; }
            }

            // A single real canvas is shared by all tabs. This keeps the
            // preview's coordinate system independent from the editor layout.
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                preview := Rectangle {
                    visible: root.active_tab == 0;
                    width: 100%;
                    height: 100%;
                    changed width => {
                        if (self.width > 1px) {
                            root.preview_width = self.width / 1px;
                            root.update_preview();
                        }
                    }
                    changed height => {
                        if (self.height > 1px) {
                            root.preview_height = self.height / 1px;
                            root.update_preview();
                        }
                    }
                }

                Image {
                    visible: root.active_tab == 0;
                    source: root.preview_image;

                    width: 100%;
                    height: 100%;

                    image-fit: contain;
                }
                TouchArea {
                    visible: root.active_tab == 0;
                    mouse-cursor: grab;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.begin_pan(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                        if (event.kind == PointerEventKind.move) {
                            root.cursor_moved(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                        }
                    }
                    moved => { root.pan_preview(self.mouse-x / 1px, self.mouse-y / 1px); }
                    scroll-event(event) => {
                        if (event.delta-y < 0) {
                            root.zoom_preview(-1);
                        } else {
                            root.zoom_preview(1);
                        }
                        accept
                    }
                }
                source-editor := VerticalLayout {
                    visible: root.active_tab == 1;
                    width: 100%; height: 100%;
                    Text { text: "Изменения вступят в силу после нажатия «Применить»."; color: #aaaaaa; }
                    TextEdit { text <=> root.source_gcode; font-family: "Consolas"; font-size: 14px; wrap: no-wrap; vertical-stretch: 1; }
                    HorizontalLayout {
                        Button { text: "Применить исходный G-code"; clicked => { root.apply_source_gcode(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                final-editor := VerticalLayout {
                    visible: root.active_tab == 2;
                    width: 100%; height: 100%;
                    Text { text: "Правки влияют только на предпросмотр."; color: #aaaaaa; }
                    TextEdit { text <=> root.final_gcode; font-family: "Consolas"; font-size: 14px; wrap: no-wrap; vertical-stretch: 1; }
                    HorizontalLayout {
                        Button { text: "Применить финальный G-code"; clicked => { root.apply_final_gcode(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            if (root.active_tab == 0) : HorizontalLayout {
                Button { text: "−"; clicked => { root.zoom_preview(-1); } }
                Button { text: "Fit"; clicked => { root.fit_preview(); } }
                Button { text: "+"; clicked => { root.zoom_preview(1); } }
                Text { text: root.cursor_coordinates; color: #aaaaaa; }
            }
}
        }
    }
}
