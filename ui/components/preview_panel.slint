import { Button } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component PreviewPanel inherits VerticalLayout {
    in property<image> preview_image;
    in-out property<float> preview_width: 1.0;
    in-out property<float> preview_height: 1.0;
    in property<string> cursor_coordinates: "X: —   Y: —";
    in property<bool> file_loaded: false;
    callback open_file(); callback size_changed(); callback begin_pan(float, float); callback pan(float, float); callback cursor_moved(float, float, float, float); callback zoom(int, float, float, float, float); callback fit();
    spacing: 6px;
    Rectangle { horizontal-stretch: 1; vertical-stretch: 1;
        changed width => { if (self.width > 1px) { root.preview_width = self.width / 1px; root.size_changed(); } }
        changed height => { if (self.height > 1px) { root.preview_height = self.height / 1px; root.size_changed(); } }
        Image { source: root.preview_image; width: 100%; height: 100%; image-fit: contain; }
        TouchArea { mouse-cursor: grab;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.begin_pan(self.mouse-x / 1px, self.mouse-y / 1px); } if (event.kind == PointerEventKind.move) { root.cursor_moved(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); } }
            moved => { root.pan(self.mouse-x / 1px, self.mouse-y / 1px); }
            scroll-event(event) => { if (event.delta-y < 0) { root.zoom(-1, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); } else { root.zoom(1, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px); } accept }
        }
        Button {
            text: "Открыть .tap";
            visible: !root.file_loaded;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            clicked => { root.open_file(); }
        }
    }
    HorizontalLayout { Button { text: "Фокусировка на области"; preferred-width: 220px; clicked => { root.fit(); } } Rectangle { horizontal-stretch: 1; } Text { text: root.cursor_coordinates; color: Theme.secondary_text; horizontal-alignment: right; } }
}
